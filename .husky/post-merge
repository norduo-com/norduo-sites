# After a pull or merge, install when pnpm-lock.yaml changed (see post-checkout).
git diff --quiet ORIG_HEAD HEAD -- pnpm-lock.yaml 2>/dev/null || pnpm install --frozen-lockfile
# A merge can add keys to .dev.vars.example; say so if this checkout's .dev.vars lacks them.
[ -f sites/berghald/.dev.vars ] && { sh sites/berghald/scripts/check-dev-vars.sh || true; }
