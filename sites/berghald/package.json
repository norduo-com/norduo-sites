{
  "name": "berghald",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "postinstall": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply berghald --local",
    "db:migrate:remote": "wrangler d1 migrations apply berghald --remote",
    "deploy": "wrangler d1 migrations apply berghald --remote && wrangler deploy",
    "db:migrate:preview": "wrangler d1 migrations apply berghald-preview --remote --env preview",
    "deploy:preview": "wrangler d1 migrations apply berghald-preview --remote --env preview && wrangler versions upload --preview-alias \"$PREVIEW_ALIAS\" --message \"$PREVIEW_ALIAS\""
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@norduo/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "@fontsource/outfit": "5.2.8",
    "@norduo/cms": "workspace:*",
    "@norduo/ui": "workspace:*",
    "hono": "^4.13.19",
    "i18next": "27.2.2",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.3",
    "react-router": "^8.5.1"
  }
}
