{
  "$schema": "node_modules/wrangler/config-schema.json",
  // THROWAWAY SPIKE: measures SSR CPU time on Workers Free. Never merged.
  "name": "berghald-ssr-spike",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "spike" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "berghald-ssr-spike",
      "database_id": "961c8519-8d63-4106-ba4b-bd32507bda11",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "berghald-media" }],
}
