{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".wrangler/deploy/**"],
      "inputs": ["$TURBO_DEFAULT$", ".dev.vars", "!**/*.md"],
      "env": ["CLOUDFLARE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "inputs": ["$TURBO_DEFAULT$", ".dev.vars", "!**/*.md"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "SENTRY_AUTH_TOKEN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy:preview": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["CLOUDFLARE_ENV"],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "PREVIEW_ALIAS",
        "SENTRY_AUTH_TOKEN"
      ]
    }
  }
}
